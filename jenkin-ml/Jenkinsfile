pipeline {
    agent any

    options {
        skipDefaultCheckout(true)
    }

    stages {
        stage('Clone') {
            steps {
                checkout scm
            }
        }

        stage('Install') {
            steps {
                dir('jenkin-ml') {
                    bat '"C:\\Users\\singh\\AppData\\Local\\Programs\\Python\\Python313\\python.exe" -m venv .venv'
                    bat '.venv\\Scripts\\python.exe -m pip install -r requirements.txt'
                }
            }
        }

        stage('Train') {
            steps {
                dir('jenkin-ml') {
                    bat '.venv\\Scripts\\python.exe train.py'
                }
            }
        }

        stage('Test') {
            steps {
                dir('jenkin-ml') {
                    bat '.venv\\Scripts\\python.exe test.py'
                }
            }
        }

        stage('Deploy') {
            steps {
                dir('jenkin-ml') {
                    bat '''
                    @echo off
                    set "JENKINS_NODE_COOKIE=dontKillMe"

                    start "" /B cmd /c ".venv\\Scripts\\python.exe app.py > app.log 2>&1"

                    powershell -NoProfile -Command "$ok=$false; for ($i=0; $i -lt 15; $i++) { try { $r=Invoke-WebRequest -Uri 'http://127.0.0.1:5000/' -UseBasicParsing -TimeoutSec 2; if ($r.StatusCode -eq 200) { $ok=$true; break } } catch {}; Start-Sleep -Seconds 2 }; if (-not $ok) { Get-Content app.log -ErrorAction SilentlyContinue; exit 1 }; Write-Output 'ML Model deployed successfully at http://localhost:5000'; exit 0"
                    '''
                }
            }
        }
    }
}